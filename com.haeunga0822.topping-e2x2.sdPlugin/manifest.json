		{
			"Name": "Mute",
			"UUID": "com.haeunga0822.topping-e2x2.mute",
			"Icon": "imgs/channel",
			"Controllers": [
				"Keypad"
			],
			"PropertyInspectorPath": "ui/toggle.html",
			"DisableAutomaticStates": true,
