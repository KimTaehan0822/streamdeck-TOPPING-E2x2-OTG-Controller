{
	"name": "streamdeck-topping-e2x2",
	"version": "1.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc",
		"bundle": "rollup -c rollup.config.mjs",
		"copy-native": "node scripts/copy-native.mjs",
		"test": "npm run build && node --test test/*.test.mjs",
		"watch": "rollup -c rollup.config.mjs -w --watch.onEnd=\"streamdeck restart com.haeunga0822.topping-e2x2\"",
		"pack": "npm run bundle && npm run copy-native && streamdeck pack com.haeunga0822.topping-e2x2.sdPlugin"
	},
	"dependencies": {
		"@elgato/streamdeck": "3.0.4",
		"node-hid": "^3.0.0"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.4",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-typescript": "^12.3.1",
		"@types/node": "^26.6.6",
		"rollup": "^4.66.0",
		"tslib": "^2.8.1",
		"typescript": "~6.0.3"
	}
}
